{
  "info": {
    "name": "Ubidots | cinco variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "device",
      "value": "equipo-rest"
    }
  ],
  "item": [
    {
      "name": "Enviar cinco variables a Ubidots",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Auth-Token",
            "value": "{{ubidots_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "https://industrial.api.ubidots.com/api/v1.6/devices/{{device}}/",
        "body": {
          "mode": "raw",
          "raw": "{\"temperature\": 24, \"humidity\": 65, \"position\": {\"value\": 1, \"context\": {\"lat\": 4.711, \"lng\": -74.0721}}, \"luminosity\": 550, \"pressure\": 750}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP correcto',()=>pm.expect(pm.response.code).to.be.within(200,299));",
              "var ubiResponse=pm.response.json();",
              "for(const key of ['temperature','humidity','position','luminosity','pressure']) pm.test('Recepción '+key,()=>pm.expect(ubiResponse[key][0].status_code).to.eql(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar y comprobar los cinco valores recibidos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Auth-Token",
            "value": "{{ubidots_token}}"
          }
        ],
        "url": "https://industrial.api.ubidots.com/api/v2.0/devices/~{{device}}/_/values/last"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Lectura HTTP 200',()=>pm.response.to.have.status(200));",
              "const values=pm.response.json();",
              "for(const [key,value] of Object.entries({temperature:24,humidity:65,luminosity:550,pressure:750})) pm.test('Valor guardado '+key,()=>pm.expect(values[key].value).to.eql(value));",
              "pm.test('Posición guardada',()=>{pm.expect(values.position.context.lat).to.eql(4.711);pm.expect(values.position.context.lng).to.eql(-74.0721);});"
            ]
          }
        }
      ]
    }
  ]
}
